# Runtime
NODE_ENV=development
PORT=3000

# Application database (users and jobs)
MONGODB_URI=mongodb://localhost:27017/exforge

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (JWT_SECRET needs at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# 64 hexadecimal characters (32 bytes), for example: openssl rand -hex 32
ENCRYPTION_SECRET=

# CORS allow-list (empty means no browser origin is allowed)
LOCAL_DOMAIN=http://localhost:5173
PROD_DOMAIN=

# Bull Board at /bull-board (disabled when either value is empty)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Object storage (any S3-compatible service: MinIO locally, Cloudflare R2 when deployed)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=exforge-exports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false

# Exports
EXPORT_TTL_HOURS=24
EXPORT_MAX_ROWS=1000000
EXPORT_ATTEMPTS=3
EXPORT_CONCURRENCY=2

# Allow source URIs that resolve to loopback, private or link-local addresses (ignored when NODE_ENV=production)
EXFORGE_ALLOW_PRIVATE_URIS=false

# Comma separated hostnames that may resolve to private addresses (applies in every environment)
EXFORGE_ALLOWED_PRIVATE_HOSTS=

# Job creations allowed per IP per minute (0 disables the limit)
JOB_RATE_LIMIT_PER_MINUTE=30

# Set to true behind a reverse proxy so the rate limit sees the real client IP
TRUST_PROXY=false
